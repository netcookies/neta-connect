;renderer=␀;sink=␀;spf=␀;sr=␀;state=␀;target_latency_ms=␀;video_max=␀;video_min=␀;zero_copy=␀<␀<!DOCTYPE html␀Ö^<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>è¿œç¨‹è¾“å…¥</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
        }
        .header {
            text-align: center;
            color: white;
            margin-bottom: 30px;
        }
        .header h1 {
            font-size: 28px;
            margin-bottom: 10px;
        }
        .status {
            display: inline-block;
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 10px;
        }
        .status.connected {
            background: rgba(76, 217, 100, 0.3);
            color: #4cd964;
            border: 1px solid #4cd964;
        }
        .status.disconnected {
            background: rgba(255, 59, 48, 0.3);
            color: #ff3b30;
            border: 1px solid #ff3b30;
        }
        .mode-switch {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            color: white;
            font-size: 14px;
            margin-top: 10px;
        }
        .switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 26px;
        }
        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(255,255,255,0.3);
            transition: .4s;
            border-radius: 26px;
        }
        .slider:before {
            position: absolute;
            content: "";
            height: 20px;
            width: 20px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }
        input:checked + .slider {
            background-color: #4cd964;
        }
        input:checked + .slider:before {
            transform: translateX(24px);
        }
        .input-container {
            background: white;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }
        textarea {
            width: 100%;
            min-height: 300px;
            padding: 16px;
            font-size: 16px;
            line-height: 1.5;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            resize: vertical;
            font-family: inherit;
            outline: none;
            transition: border-color 0.3s;
        }
        textarea:focus {
            border-color: #667eea;
        }
        .button-group {
            display: flex;
            gap: 12px;
            margin-top: 16px;
        }
        button {
            flex: 1;
            padding: 14px;
            font-size: 16px;
            font-weight: 600;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s;
            color: white;
        }
        button.clear {
            background: #ff3b30;
        }
        button.clear:active {
            background: #e0342a;
            transform: scale(0.98);
        }
        button.paste {
            background: #667eea;
        }
        button.paste:active {
            background: #5568d3;
            transform: scale(0.98);
        }
        button.send {
            background: #4cd964;
        }
        button.send:active {
            background: #44c057;
            transform: scale(0.98);
        }
        button.send:disabled {
            background: #ccc;
            cursor: not-allowed;
        }
        .footer {
            text-align: center;
            color: rgba(255,255,255,0.8);
            margin-top: 20px;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>í ½íº— è¿œç¨‹è¾“å…¥</h1>
            <div class="status disconnected" id="status">æœªè¿æ¥</div>
            <div class="mode-switch">
                <span>WebSocket</span>
                <label class="switch">
                    <input type="checkbox" id="modeSwitch" onchange="toggleMode()">
                    <span class="slider"></span>
                </label>
                <span>POST</span>
            </div>
        </div>

        <div class="input-container">
            <textarea id="inputText" placeholder="åœ¨è¿™é‡Œè¾“å…¥æ–‡æœ¬..." autofocus></textarea>
            <div class="button-group">
                <button class="clear" onclick="clearText()">æ¸…ç©º</button>
                <button class="paste" onclick="pasteText()">ç²˜è´´</button>
                <button class="send" id="sendBtn" onclick="sendTextManually()" style="display: none;">å‘é€</button>
            </div>
        </div>

        <div class="footer" id="footerText">
            WebSocket æ¨¡å¼ï¼šè¾“å…¥çš„å†…å®¹ä¼šå®æ—¶åŒæ­¥åˆ°è½¦æœº
        </div>
    </div>

    <script>
        let ws = null;
        let isConnected = false;
        let usePostMode = false;
        let reconnectAttempts = 0;
        const maxReconnectAttempts = 3;
        const textarea = document.getElementById('inputText');
        const statusEl = document.getElementById('status');
        const sendBtn = document.getElementById('sendBtn');
        const footerText = document.getElementById('footerText');
        const modeSwitch = document.getElementById('modeSwitch');

        // åˆ‡æ¢æ¨¡å¼
        function toggleMode() {
            usePostMode = modeSwitch.checked;
            if (usePostMode) {
                // åˆ‡æ¢åˆ° POST æ¨¡å¼
                if (ws) {
                    ws.close();
                }
                statusEl.textContent = 'POST æ¨¡å¼';
                statusEl.className = 'status connected';
                sendBtn.style.display = 'block';
                footerText.textContent = 'POST æ¨¡å¼ï¼šç‚¹å‡»"å‘é€"æŒ‰é’®æäº¤æ–‡æœ¬åˆ°è½¦æœº';
            } else {
                // åˆ‡æ¢åˆ° WebSocket æ¨¡å¼
                sendBtn.style.display = 'none';
                footerText.textContent = 'WebSocket æ¨¡å¼ï¼šè¾“å…¥çš„å†…å®¹ä¼šå®æ—¶åŒæ­¥åˆ°è½¦æœº';
                reconnectAttempts = 0;
                connect();
            }
        }

        // è¿æ¥ WebSocket
        function connect() {
            if (usePostMode) return;

            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            const wsUrl = protocol + '//' + window.location.host + '/ws';

            ws = new WebSocket(wsUrl);

            ws.onopen = () => {
                isConnected = true;
                reconnectAttempts = 0;
                statusEl.textContent = 'å·²è¿æ¥ (WebSocket)';
                statusEl.className = 'status connected';
                console.log('WebSocket è¿æ¥æˆåŠŸ');
            };

            ws.onclose = () => {
                isConnected = false;
                statusEl.textContent = 'æœªè¿æ¥';
                statusEl.className = 'status disconnected';
                console.log('WebSocket è¿æ¥å…³é—­');

                // é‡è¿é€»è¾‘
                reconnectAttempts++;
                if (reconnectAttempts <= maxReconnectAttempts) {
                    setTimeout(connect, 3000);
                } else {
                    // è‡ªåŠ¨é™çº§åˆ° POST æ¨¡å¼
                    console.log('WebSocket è¿æ¥å¤±è´¥æ¬¡æ•°è¿‡å¤šï¼Œè‡ªåŠ¨åˆ‡æ¢åˆ° POST æ¨¡å¼');
                    modeSwitch.checked = true;
                    toggleMode();
                }
            };

            ws.onerror = (error) => {
                console.error('WebSocket é”™è¯¯:', error);
            };
        }

        // å‘é€æ–‡æœ¬æ›´æ–°ï¼ˆWebSocketï¼‰
        function sendText(text) {
            if (isConnected && ws) {
                ws.send(text);
            }
        }

        // å‘é€æ–‡æœ¬ï¼ˆPOSTï¼‰
        async function sendTextManually() {
            const text = textarea.value;
            sendBtn.disabled = true;
            sendBtn.textContent = 'å‘é€ä¸­...';

            try {
                const response = await fetch('/api/input', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ text: text })
                });

                const result = await response.json();

                if (result.success) {
                    statusEl.textContent = 'å‘é€æˆåŠŸ';
                    statusEl.className = 'status connected';
                    setTimeout(() => {
                        statusEl.textContent = 'POST æ¨¡å¼';
                    }, 2000);
                } else {
                    statusEl.textContent = 'å‘é€å¤±è´¥: ' + result.error;
                    statusEl.className = 'status disconnected';
                }
            } catch (error) {
                statusEl.textContent = 'å‘é€å¤±è´¥: ' + error.message;
                statusEl.className = 'status disconnected';
            } finally {
                sendBtn.disabled = false;
                sendBtn.textContent = 'å‘é€';
            }
        }

        // ç›‘å¬è¾“å…¥å˜åŒ–ï¼ˆä»… WebSocket æ¨¡å¼ï¼‰
        textarea.addEventListener('input', (e) => {
            if (!usePostMode) {
                sendText(e.target.value);
            }
        });

        // æ¸…ç©ºæ–‡æœ¬
        function clearText() {
            textarea.value = '';
            if (!usePostMode) {
                sendText('');
            }
        }

        // ç²˜è´´æ–‡æœ¬
        async function pasteText() {
            try {
                const text = await navigator.clipboard.readText();
                textarea.value = text;
                if (!usePostMode) {
                    sendText(text);
                }
            } catch (err) {
                // å¦‚æœæµè§ˆå™¨ä¸æ”¯æŒå‰ªè´´æ¿ APIï¼Œæç¤ºç”¨æˆ·æ‰‹åŠ¨ç²˜è´´
                alert('è¯·ä½¿ç”¨ Ctrl+V æˆ–é•¿æŒ‰ç²˜è´´');
            }
        }

        // é¡µé¢åŠ è½½æ—¶è¿æ¥ï¼ˆWebSocket æ¨¡å¼ï¼‰
        if (!usePostMode) {
            connect();
        }

        // ============ Token åŒæ­¥åŠŸèƒ½ ============
        async function syncTokenFromBoxJS() {
            try {
                // ä» BoxJS è¯»å– token
                const tokenResponse = await fetch('http://boxjs.com/query/data/@netaconnect.token');
                const tokenData = await tokenResponse.json();
                const token = tokenData.val;

                if (!token) {
                    console.log('æœªæ‰¾åˆ° token');
                    return;
                }

                // ç›´æ¥ POST token åˆ°è½¦æœº
                const postResponse = await fetch('/api/input', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text: token })
                });

                if (postResponse.ok) {
                    console.log('Token å‘é€æˆåŠŸ');

                    // ä¿å­˜è½¦æœº IP åˆ° BoxJS
                    const carIp = window.location.hostname;
                    await fetch('http://boxjs.com/api/save', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            key: '@netaconnect.car_ip',
                            val: carIp
                        })
                    });

                    console.log('Token åŒæ­¥å®Œæˆï¼Œè½¦æœº IP å·²ä¿å­˜');
                } else {
                    console.error('Token å‘é€å¤±è´¥');
                }
            } catch (error) {
                console.error('Token åŒæ­¥å¤±è´¥:', error);
            }
        }

        // é¡µé¢åŠ è½½æ—¶è‡ªåŠ¨åŒæ­¥ token
        window.addEventListener('load', () => {
            setTimeout(syncTokenFromBoxJS, 1000);
        });
    </script>
